---
import Container from "./Container.astro";
import LogoMark from "./LogoMark.astro";
import type { Locale } from "../i18n/config";
import {
  getLocalizedPath,
  navigationOrder,
  type RouteKey,
} from "../i18n/routes";
import { sharedCopy } from "../i18n/shared";

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
}

const { locale, currentRoute } = Astro.props;
const copy = sharedCopy[locale];
---

<header class="navbar" data-navbar>
  <Container size="wide">
    <div class="bar">
      <a
        class="brand"
        href={getLocalizedPath("home", locale)}
        aria-label="LATYS"
      >
        <LogoMark />
        <span>LATYS</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="primary-menu"
        aria-expanded="false"
        data-menu-toggle
        data-open-label={copy.openNavigation}
        data-close-label={copy.closeNavigation}
      >
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        <span data-menu-label>{copy.openNavigation}</span>
      </button>

      <div class="menu" id="primary-menu" data-menu>
        <nav aria-label={copy.primaryNavigation}>
          <ul class="nav-list">
            {
              navigationOrder.map((route) => (
                <li>
                  <a
                    href={getLocalizedPath(route, locale)}
                    aria-current={currentRoute === route ? "page" : undefined}
                  >
                    {copy.navigation[route]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <label class="language">
          <span>{copy.languageLabel}</span>
          <select data-language-select aria-label={copy.languageLabel}>
            <option
              value={getLocalizedPath(currentRoute, "en")}
              selected={locale === "en"}
            >
              {copy.languages.en}
            </option>
            <option
              value={getLocalizedPath(currentRoute, "fr")}
              selected={locale === "fr"}
            >
              {copy.languages.fr}
            </option>
          </select>
        </label>
      </div>
    </div>
  </Container>
</header>

<script>
  const navbars = document.querySelectorAll<HTMLElement>("[data-navbar]");

  navbars.forEach((navbar) => {
    const toggle =
      navbar.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = navbar.querySelector<HTMLElement>("[data-menu]");
    const label = navbar.querySelector<HTMLElement>("[data-menu-label]");

    if (toggle && menu && label) {
      const setOpen = (open: boolean) => {
        navbar.toggleAttribute("data-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        label.textContent = open
          ? (toggle.dataset.closeLabel ?? "")
          : (toggle.dataset.openLabel ?? "");
      };

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggle.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false);
          toggle.focus();
        }
      });
    }

    navbar
      .querySelectorAll<HTMLSelectElement>("[data-language-select]")
      .forEach((select) => {
        select.addEventListener("change", () => {
          window.location.assign(select.value);
        });
      });
  });
</script>

<style>
  .navbar {
    --color-logo: var(--color-on-dark);
    --logo-size: 3rem;

    position: sticky;
    z-index: 20;
    top: 0;
    border-block-end: 0.0625rem solid rgb(255 255 255 / 11%);
    background: rgb(7 20 72 / 94%);
    color: var(--color-on-dark);
  }

  @supports (backdrop-filter: blur(1rem)) {
    .navbar {
      background: rgb(7 20 72 / 82%);
      backdrop-filter: blur(1rem);
    }
  }

  .bar {
    display: flex;
    min-block-size: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    position: relative;
    z-index: 2;
    color: var(--color-on-dark);
    font-size: 1.08rem;
    font-weight: 760;
    letter-spacing: 0.22em;
    line-height: 1;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    position: relative;
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    color: rgb(247 249 255 / 72%);
    font-size: 0.83rem;
    font-weight: 650;
    letter-spacing: 0.035em;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-list a::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    block-size: 0.125rem;
    background: var(--color-accent);
    content: "";
    opacity: 0;
    transform: scaleX(0.45);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .nav-list a:hover,
  .nav-list a[aria-current="page"] {
    color: var(--color-on-dark);
  }

  .nav-list a[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .language {
    display: grid;
    gap: 0.1rem;
    color: rgb(247 249 255 / 60%);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  select {
    min-block-size: 2rem;
    padding: 0 1.6rem 0 0;
    border: 0;
    background: transparent;
    color: var(--color-on-dark);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 650;
  }

  select option {
    background: var(--color-primary);
    color: var(--color-on-dark);
  }

  .menu-toggle {
    display: none;
    min-block-size: 2.75rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-on-dark);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .menu-icon {
    display: grid;
    inline-size: 1.25rem;
    gap: 0.35rem;
  }

  .menu-icon i {
    display: block;
    block-size: 0.0625rem;
    background: currentColor;
    transition: transform var(--transition-fast);
  }

  @media (max-width: 51.99rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .menu {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      padding: 1.25rem clamp(1.25rem, 4vw, 3rem) 1.75rem;
      border-block-end: 0.0625rem solid rgb(255 255 255 / 11%);
      background: var(--color-primary);
      box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 18%);
    }

    .navbar[data-open] .menu {
      display: grid;
      gap: 1.5rem;
    }

    .navbar[data-open] .menu-icon i:first-child {
      transform: translateY(0.2rem) rotate(45deg);
    }

    .navbar[data-open] .menu-icon i:last-child {
      transform: translateY(-0.2rem) rotate(-45deg);
    }

    .nav-list {
      display: grid;
      gap: 0;
    }

    .nav-list a {
      inline-size: 100%;
      min-block-size: 3.25rem;
      border-block-end: 0.0625rem solid rgb(255 255 255 / 9%);
    }

    .nav-list a::after {
      right: auto;
      bottom: 0;
      inline-size: 2rem;
    }

    .language {
      justify-self: start;
    }
  }
</style>
