<style>
  .solution-network-animation {
    --solution-cycle: 22s;

    display: grid;
    inline-size: 100%;
    min-block-size: 100%;
    place-items: center;
    background-color: var(--color-primary, #071448);
  }

  svg {
    inline-size: 100%;
    overflow: visible;
  }

  .scene {
    animation: solution-scene var(--solution-cycle) linear infinite;
  }

  .solution-layer {
    opacity: 0;
    transform: translate(var(--start-x), var(--start-y));
    transform-origin: 310px 255px;
    animation: solution-assemble var(--solution-cycle) cubic-bezier(0.45, 0, 0.2, 1) infinite;
    animation-delay: calc(var(--index) * 80ms);
  }

  .solution-plane {
    fill: url(#solution-plane-fill);
    stroke: #87e4ff;
    stroke-opacity: 0.7;
    stroke-width: 1.25;
  }

  .solution-grid {
    fill: url(#solution-plane-grid);
    stroke: none;
  }

  .solution-foundation-layer,
  .solution-foundation-halo,
  .solution-halo,
  .solution-logo-signal {
    opacity: 0;
  }

  .solution-foundation-layer {
    animation: solution-foundation var(--solution-cycle) ease-in-out infinite;
  }

  .solution-foundation-plane {
    fill: url(#solution-foundation-fill);
    stroke: #ffad76;
    stroke-opacity: 0.8;
    stroke-width: 1.25;
  }

  .solution-foundation-grid {
    fill: url(#solution-foundation-grid);
    stroke: none;
  }

  .solution-foundation-halo {
    animation: solution-foundation-halo var(--solution-cycle) ease-in-out infinite;
  }

  .solution-halo {
    transform-origin: center;
    animation: solution-halo var(--solution-cycle) ease-in-out infinite;
  }

  .solution-logo-signal {
    animation: solution-logo-signal var(--solution-cycle) ease-in-out infinite;
  }

  .solution-logo-bloom {
    opacity: 0.72;
  }

  .route-line,
  .route-tracer {
    fill: none;
    stroke: var(--color-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .route-line {
    stroke-width: 1.75;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: solution-route var(--solution-cycle) ease-out infinite;
  }

  .route-tracer {
    opacity: 0;
    stroke-width: 3.25;
    stroke-dasharray: 0.09 0.91;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 0.45rem var(--color-accent));
    animation: solution-tracer var(--solution-cycle) ease-out infinite;
  }

  .asset {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .asset-city {
    animation: solution-city var(--solution-cycle) ease-in-out infinite;
  }

  .asset-logistics {
    animation: solution-logistics var(--solution-cycle) ease-in-out infinite;
  }

  .asset-data {
    animation: solution-data var(--solution-cycle) ease-in-out infinite;
  }

  .asset-edge {
    animation: solution-edge var(--solution-cycle) ease-in-out infinite;
  }

  .asset-bloom {
    opacity: 0;
  }

  .city-bloom {
    animation: solution-city-bloom var(--solution-cycle) ease-in-out infinite;
  }

  .logistics-bloom {
    animation: solution-logistics-bloom var(--solution-cycle) ease-in-out infinite;
  }

  .data-bloom {
    animation: solution-data-bloom var(--solution-cycle) ease-in-out infinite;
  }

  .edge-bloom {
    animation: solution-edge-bloom var(--solution-cycle) ease-in-out infinite;
  }

  @keyframes solution-scene {
    0%, 2.1% { opacity: 0; }
    2.5%, 86% { opacity: 1; }
    93%, 100% { opacity: 0; }
  }

  @keyframes solution-assemble {
    0%, 2.1% {
      opacity: 0;
      transform: translate(var(--start-x), var(--start-y));
    }
    5.7% { opacity: 0.28; }
    17.7% {
      opacity: 0.86;
      transform: translate(0, var(--rest-y));
    }
    23%, 100% {
      opacity: 1;
      transform: translate(0, var(--rest-y));
    }
  }

  @keyframes solution-halo {
    0%, 18% {
      opacity: 0;
      transform: scale(0.78);
    }
    23%, 100% {
      opacity: 0.72;
      transform: scale(1);
    }
  }

  @keyframes solution-logo-signal {
    0%, 18% { opacity: 0; }
    23%, 100% { opacity: 0.92; }
  }

  @keyframes solution-foundation {
    0%, 23% { opacity: 0; }
    31%, 100% { opacity: 0.82; }
  }

  @keyframes solution-foundation-halo {
    0%, 25% { opacity: 0; }
    31%, 100% { opacity: 0.68; }
  }

  @keyframes solution-route {
    0%, 31% { stroke-dashoffset: 1; }
    42%, 100% { stroke-dashoffset: 0; }
  }

  @keyframes solution-tracer {
    0%, 31% {
      opacity: 0;
      stroke-dashoffset: 1;
    }
    31.5% { opacity: 1; }
    41.5% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
    42%, 100% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
  }

  @keyframes solution-city {
    0%, 42% { opacity: 0; transform: scale(0.96); }
    49%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes solution-logistics {
    0%, 48% { opacity: 0; transform: scale(0.96); }
    55%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes solution-data {
    0%, 54% { opacity: 0; transform: scale(0.96); }
    61%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes solution-edge {
    0%, 60% { opacity: 0; transform: scale(0.96); }
    67%, 100% { opacity: 1; transform: scale(1); }
  }

  @keyframes solution-city-bloom {
    0%, 46% { opacity: 0; }
    49%, 100% { opacity: 0.62; }
  }

  @keyframes solution-logistics-bloom {
    0%, 52% { opacity: 0; }
    55%, 100% { opacity: 0.62; }
  }

  @keyframes solution-data-bloom {
    0%, 58% { opacity: 0; }
    61%, 100% { opacity: 0.62; }
  }

  @keyframes solution-edge-bloom {
    0%, 64% { opacity: 0; }
    67%, 100% { opacity: 0.62; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene,
    .solution-layer,
    .solution-halo,
    .solution-logo-signal,
    .solution-foundation-layer,
    .solution-foundation-halo,
    .route-line,
    .asset,
    .asset-bloom {
      animation: none;
    }

    .scene { opacity: 1; }
    .solution-layer {
      opacity: 0.72;
      transform: translate(0, var(--rest-y));
    }
    .solution-halo { opacity: 0.42; transform: scale(1); }
    .solution-logo-signal { opacity: 0.75; }
    .solution-logo-bloom { opacity: 0.42; }
    .solution-foundation-layer { opacity: 0.64; }
    .solution-foundation-halo { opacity: 0.36; }
    .route-line { stroke-dashoffset: 0; }
    .route-tracer { display: none; }
    .asset { opacity: 1; transform: scale(1); }
    .asset-bloom { opacity: 0.45; }
  }
</style>
