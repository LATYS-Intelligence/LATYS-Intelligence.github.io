---
import ApplicationIcon from "./ApplicationIcon.astro";
import BrandText from "./BrandText.astro";
import Container from "./Container.astro";
import Section from "./Section.astro";
import {
  frontmatter as englishApplications,
} from "../content/home/applications.en.md";
import {
  frontmatter as frenchApplications,
} from "../content/home/applications.fr.md";
import type { Locale } from "../i18n/config";

type ApplicationIconName =
  | "edge-ai"
  | "remote-operations"
  | "adaptive-connectivity"
  | "temporary-networks"
  | "mmwave-extension"
  | "infrastructure-reduction"
  | "mission-critical"
  | "private-5g"
  | "indoor-outdoor";

interface Application {
  title: string;
  lead: string;
  paragraphs: string[];
  icon: ApplicationIconName;
}

interface ApplicationsContent {
  eyebrow: string;
  heading: string;
  navigation: {
    previousLabel: string;
    nextLabel: string;
    positionLabel: string;
  };
  applications: Application[];
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = {
  en: englishApplications as ApplicationsContent,
  fr: frenchApplications as ApplicationsContent,
} satisfies Record<Locale, ApplicationsContent>;
const copy = content[locale];
---

<Section id="applications" tone="purple" spacing="spacious">
  <Container size="wide">
    <div class="applications-section">
      <header class="section-heading">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2><BrandText text={copy.heading} /></h2>
      </header>

      <div class="applications-workbench" data-applications-root>
        <div
          class="mobile-application-pager"
          data-application-pager
          data-position-template={copy.navigation.positionLabel}
        >
          <button
            class="pager-button"
            type="button"
            aria-label={copy.navigation.previousLabel}
            data-application-previous
            disabled
          >
            <span aria-hidden="true">←</span>
          </button>

          <div class="mobile-application-current">
            <span class="mobile-application-meta" aria-hidden="true">
              <span class="mobile-application-marker"></span>
              <span data-application-counter>
                01 / {String(copy.applications.length).padStart(2, "0")}
              </span>
            </span>
            <span class="mobile-application-title" data-application-title>
              {copy.applications[0].title}
            </span>
          </div>

          <button
            class="pager-button"
            type="button"
            aria-label={copy.navigation.nextLabel}
            data-application-next
          >
            <span aria-hidden="true">→</span>
          </button>

          <span
            class="visually-hidden"
            aria-live="polite"
            aria-atomic="true"
            data-application-announcement
          >
            {copy.navigation.positionLabel
              .replace("{current}", "1")
              .replace("{total}", String(copy.applications.length))
              .replace("{title}", copy.applications[0].title)}
          </span>
        </div>

        <div
          class="application-tabs"
          role="tablist"
          aria-label={copy.heading}
        >
          {
            copy.applications.map((application, index) => {
              const tabId = `application-${locale}-tab-${index + 1}`;
              const panelId = `application-${locale}-panel-${index + 1}`;

              return (
                <button
                  class="application-tab"
                  id={tabId}
                  type="button"
                  role="tab"
                  aria-controls={panelId}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-application-tab
                  data-active={index === 0 ? "" : undefined}
                >
                  <span class="tab-marker" aria-hidden="true"></span>
                  <span class="tab-icon" aria-hidden="true">
                    <ApplicationIcon name={application.icon} />
                  </span>
                  <span class="tab-title">{application.title}</span>
                </button>
              );
            })
          }
        </div>

        <div class="application-canvas">
          {
            copy.applications.map((application, index) => {
              const tabId = `application-${locale}-tab-${index + 1}`;
              const panelId = `application-${locale}-panel-${index + 1}`;

              return (
                <article
                  class="application-panel"
                  id={panelId}
                  role="tabpanel"
                  aria-labelledby={tabId}
                  aria-hidden={index === 0 ? "false" : "true"}
                  tabindex={index === 0 ? 0 : -1}
                  data-application-panel
                  data-active={index === 0 ? "" : undefined}
                >
                  <span class="panel-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{application.title}</h3>
                  <p class="application-lead">{application.lead}</p>
                  <div class="application-copy">
                    {application.paragraphs.map((paragraph) => (
                      <p><BrandText text={paragraph} /></p>
                    ))}
                  </div>
                  <span class="panel-icon" aria-hidden="true">
                    <ApplicationIcon name={application.icon} />
                  </span>
                </article>
              );
            })
          }
        </div>
      </div>
    </div>
  </Container>
</Section>

<script>
  const applicationRoots = document.querySelectorAll<HTMLElement>(
    "[data-applications-root]",
  );

  applicationRoots.forEach((root) => {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-application-tab]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-application-panel]"),
    );
    const pager = root.querySelector<HTMLElement>("[data-application-pager]");
    const previousButton = root.querySelector<HTMLButtonElement>(
      "[data-application-previous]",
    );
    const nextButton = root.querySelector<HTMLButtonElement>(
      "[data-application-next]",
    );
    const mobileCounter = root.querySelector<HTMLElement>(
      "[data-application-counter]",
    );
    const mobileTitle = root.querySelector<HTMLElement>(
      "[data-application-title]",
    );
    const announcement = root.querySelector<HTMLElement>(
      "[data-application-announcement]",
    );
    const hasPreciseHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    );
    let activeIndex = 0;
    let touchPreviewIndex: number | null = null;
    let lastPointerType: string | null = null;

    const getTitle = (index: number) =>
      tabs[index]
        ?.querySelector<HTMLElement>(".tab-title")
        ?.textContent?.trim() ?? "";

    const updatePager = (index: number) => {
      const title = getTitle(index);
      const current = String(index + 1);
      const total = String(tabs.length);

      if (mobileCounter) {
        mobileCounter.textContent = `${current.padStart(2, "0")} / ${total.padStart(2, "0")}`;
      }

      if (mobileTitle) mobileTitle.textContent = title;

      if (previousButton) {
        previousButton.disabled = index === 0;
        if (panels[index - 1]) {
          previousButton.setAttribute("aria-controls", panels[index - 1].id);
        } else {
          previousButton.removeAttribute("aria-controls");
        }
      }

      if (nextButton) {
        nextButton.disabled = index === tabs.length - 1;
        if (panels[index + 1]) {
          nextButton.setAttribute("aria-controls", panels[index + 1].id);
        } else {
          nextButton.removeAttribute("aria-controls");
        }
      }

      if (announcement && pager?.dataset.positionTemplate) {
        announcement.textContent = pager.dataset.positionTemplate
          .replace("{current}", current)
          .replace("{total}", total)
          .replace("{title}", title);
      }
    };

    const previewIcon = (index: number | null) => {
      tabs.forEach((tab, tabIndex) => {
        tab.toggleAttribute("data-icon-preview", tabIndex === index);
      });

      panels.forEach((panel, panelIndex) => {
        panel.toggleAttribute("data-icon-preview", panelIndex === index);
      });
    };

    const activate = (index: number, moveFocus = false) => {
      if (!tabs[index] || !panels[index]) return;

      activeIndex = index;

      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === index;
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        tab.toggleAttribute("data-active", isActive);
      });

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === index;
        panel.setAttribute("aria-hidden", String(!isActive));
        panel.tabIndex = isActive ? 0 : -1;
        panel.toggleAttribute("data-active", isActive);
      });

      updatePager(index);

      if (moveFocus) tabs[index].focus();
    };

    previousButton?.addEventListener("click", () => {
      activate(activeIndex - 1);
    });

    nextButton?.addEventListener("click", () => {
      activate(activeIndex + 1);
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener("pointerdown", (event) => {
        lastPointerType = event.pointerType;
      });

      tab.addEventListener("pointerenter", (event) => {
        if (!hasPreciseHover.matches || event.pointerType === "touch") return;

        touchPreviewIndex = null;
        activate(index);
        previewIcon(index);
      });

      tab.addEventListener("pointerleave", (event) => {
        if (!hasPreciseHover.matches || event.pointerType === "touch") return;

        previewIcon(null);
      });

      tab.addEventListener("click", () => {
        activate(index);

        if (lastPointerType === "touch" || !hasPreciseHover.matches) {
          touchPreviewIndex = index;
          previewIcon(index);
        }

        lastPointerType = null;
      });

      tab.addEventListener("focus", () => {
        activate(index);

        if (touchPreviewIndex === null) previewIcon(index);
      });

      tab.addEventListener("blur", () => {
        if (touchPreviewIndex === null) previewIcon(null);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "Enter" || event.key === " ") {
          touchPreviewIndex = null;
          previewIcon(index);
          return;
        }

        switch (event.key) {
          case "ArrowRight":
            nextIndex = (index + 1) % tabs.length;
            break;
          case "ArrowLeft":
            nextIndex = (index - 1 + tabs.length) % tabs.length;
            break;
          case "ArrowDown":
            nextIndex = (index + 3) % tabs.length;
            break;
          case "ArrowUp":
            nextIndex = (index - 3 + tabs.length) % tabs.length;
            break;
          case "Home":
            nextIndex = 0;
            break;
          case "End":
            nextIndex = tabs.length - 1;
            break;
        }

        if (nextIndex === undefined) return;

        event.preventDefault();
        touchPreviewIndex = null;
        previewIcon(nextIndex);
        activate(nextIndex, true);
      });
    });

    updatePager(activeIndex);
  });
</script>

<style>
  .applications-section {
    position: relative;
    isolation: isolate;
  }

  .applications-section::before {
    position: absolute;
    z-index: -1;
    top: -10rem;
    right: -12rem;
    inline-size: 38rem;
    block-size: 38rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 158 103 / 11%), transparent 68%);
    content: "";
    pointer-events: none;
  }

  .section-heading {
    max-inline-size: 62rem;
    margin-block-end: clamp(3.5rem, 8vw, 6rem);
  }

  .eyebrow {
    margin-block-end: 1rem;
    color: var(--color-accent);
    font-size: 0.73rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    max-inline-size: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 1.04;
  }

  .applications-workbench {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .mobile-application-pager {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    gap: 0.625rem;
    align-items: center;
  }

  .pager-button {
    display: grid;
    inline-size: 3rem;
    block-size: 3rem;
    padding: 0;
    place-items: center;
    border: 0.0625rem solid rgb(255 158 103 / 72%);
    border-radius: 50%;
    background: rgb(255 158 103 / 12%);
    color: var(--color-accent);
    cursor: pointer;
    font-size: 1.35rem;
    opacity: 1;
    visibility: visible;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .pager-button span {
    display: block;
    color: inherit;
    opacity: 1;
    visibility: visible;
  }

  .pager-button:hover:not(:disabled) {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .pager-button:focus-visible {
    outline: 0.125rem solid var(--color-accent);
    outline-offset: 0.1875rem;
  }

  .pager-button:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .mobile-application-current {
    display: flex;
    min-inline-size: 0;
    min-block-size: 6.5rem;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    border: 0.0625rem solid var(--color-accent-light);
    border-radius: var(--radius-small);
    background: var(--color-accent-light);
    color: var(--color-primary);
  }

  .mobile-application-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent-ink);
    font-family: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .mobile-application-marker {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-purple);
  }

  .mobile-application-title {
    min-inline-size: 0;
    font-size: clamp(0.9rem, 4vw, 1.05rem);
    font-weight: 680;
    line-height: 1.3;
    overflow-wrap: normal;
    text-wrap: balance;
    word-break: normal;
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .application-tabs {
    display: none;
  }

  .application-tab {
    position: relative;
    display: flex;
    min-inline-size: 0;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 0.75rem;
    overflow: hidden;
    border: 0.0625rem solid rgb(247 249 255 / 13%);
    border-radius: var(--radius-small);
    background: rgb(255 255 255 / 4%);
    color: var(--color-on-dark);
    cursor: pointer;
    text-align: start;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .application-tab::before {
    position: absolute;
    top: 0;
    left: 0;
    inline-size: 100%;
    block-size: 0.1875rem;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms ease;
  }

  .application-tab:hover {
    border-color: rgb(255 158 103 / 42%);
    background: rgb(255 255 255 / 8%);
  }

  .application-tab:focus-visible {
    outline-color: var(--color-accent);
  }

  .application-tab[data-active] {
    border-color: var(--color-accent-light);
    background: var(--color-accent-light);
    color: var(--color-primary);
    transform: translateY(-0.125rem);
  }

  .application-tab[data-active]::before {
    transform: scaleX(1);
  }

  .tab-marker {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-purple);
    box-shadow: 0 0 0 0.0625rem rgb(247 249 255 / 24%);
    transition:
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .application-tab:is(:hover, :focus-visible, [data-active]) .tab-marker {
    background: var(--color-accent);
    box-shadow: none;
  }

  .tab-icon,
  .panel-icon {
    display: none;
  }

  .tab-icon {
    --application-city-filter: brightness(0) saturate(100%) invert(79%) sepia(53%) saturate(1625%) hue-rotate(313deg) brightness(105%) contrast(101%);

    position: absolute;
    top: 0.8rem;
    right: 0.75rem;
    inline-size: 3rem;
    color: var(--color-accent);
    font-size: 1.25rem;
    opacity: 0.72;
    pointer-events: none;
    transform: translate(0) scale(1);
    transform-origin: center;
    transition:
      color var(--transition-fast),
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .application-tab[data-active] .tab-icon {
    --application-city-filter: brightness(0) saturate(100%) invert(13%) sepia(33%) saturate(2655%) hue-rotate(194deg) brightness(89%) contrast(105%);

    color: var(--color-purple);
    opacity: 0.52;
  }

  .application-tab[data-icon-preview] .tab-icon {
    opacity: 0;
    transform: translate(0.35rem, 0.15rem) scale(0.84);
  }

  .panel-number {
    color: var(--color-accent);
    font-family: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .tab-title {
    font-size: clamp(0.78rem, 1.3vw, 0.92rem);
    font-weight: 680;
    line-height: 1.3;
    opacity: 0.68;
    overflow-wrap: normal;
    text-wrap: balance;
    transition: opacity var(--transition-fast);
    word-break: normal;
  }

  .application-tab:is(:hover, :focus-visible, [data-active]) .tab-title {
    opacity: 1;
  }

  .application-canvas {
    --color-accent: var(--color-accent-ink);

    display: grid;
    min-inline-size: 0;
    overflow: hidden;
    border: 0.0625rem solid rgb(247 249 255 / 16%);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: 0 1.75rem 4.5rem rgb(0 0 0 / 18%);
    color: var(--color-ink);
  }

  .application-panel {
    position: relative;
    grid-area: 1 / 1;
    isolation: isolate;
    min-inline-size: 0;
    min-block-size: 31rem;
    padding: clamp(2rem, 5vw, 4rem);
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.6rem);
    visibility: hidden;
    transition:
      opacity 200ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 260ms;
  }

  .application-panel[data-active] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .panel-icon {
    --application-city-filter: brightness(0) saturate(100%) invert(13%) sepia(33%) saturate(2655%) hue-rotate(194deg) brightness(89%) contrast(105%);

    position: absolute;
    z-index: 0;
    top: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    inline-size: clamp(6rem, 12vw, 10rem);
    color: var(--color-purple);
    font-size: clamp(2.75rem, 7vw, 5rem);
    opacity: 0;
    pointer-events: none;
    transform: translate(0.65rem, 0.5rem) scale(0.86);
    transform-origin: bottom right;
    transition:
      opacity 200ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .application-panel[data-icon-preview] .panel-icon {
    opacity: 1;
    transform: translate(0) scale(1);
  }

  .panel-number {
    position: relative;
    z-index: 1;
    display: block;
    margin-block-end: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--color-accent-ink);
  }

  .application-panel h3 {
    position: relative;
    z-index: 1;
    max-inline-size: 14ch;
    margin-block-end: 1.25rem;
    color: var(--color-purple);
    font-size: clamp(1.8rem, 4vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .application-lead {
    position: relative;
    z-index: 1;
    max-inline-size: 34rem;
    margin-block-end: 1.5rem;
    color: var(--color-ink);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 620;
    line-height: 1.55;
  }

  .application-copy {
    position: relative;
    z-index: 1;
    max-inline-size: 39rem;
    padding-inline-start: clamp(1rem, 2.5vw, 1.75rem);
    border-inline-start: 0.125rem solid var(--color-accent-ink);
    color: var(--color-muted);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .application-copy p {
    margin: 0;
  }

  .application-copy p + p {
    margin-block-start: 1rem;
  }

  @media (min-width: 48rem) {
    .mobile-application-pager {
      display: none;
    }

    .application-tabs {
      display: grid;
      grid-auto-columns: initial;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(7.75rem, auto));
      gap: 0.75rem;
      padding: 0.1875rem;
    }

    .tab-icon,
    .panel-icon {
      display: block;
    }
  }

  @media (min-width: 72rem) {
    .applications-workbench {
      grid-template-columns: minmax(29rem, 0.82fr) minmax(0, 1.18fr);
    }

    .application-panel {
      padding: clamp(2.5rem, 4vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-button,
    .application-tab,
    .application-tab::before,
    .application-panel,
    .tab-icon,
    .panel-icon {
      transition: none;
    }
  }
</style>
