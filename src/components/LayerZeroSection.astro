---
import type { LayerZeroCopy } from "../i18n/pages/home";
import BrandText from "./BrandText.astro";
import Container from "./Container.astro";
import OsiStack from "./OsiStack.astro";
import Section from "./Section.astro";

interface Props {
  copy: LayerZeroCopy;
}

const { copy } = Astro.props;
---

<Section id="layer-zero" tone="paper">
  <Container>
    <div class="layer-zero">
      <div class="ambient" aria-hidden="true"></div>

      <header class="intro">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2><BrandText text={copy.heading} /></h2>
        <p class="summary">{copy.introduction}</p>
      </header>

      <div class="layout">
        <OsiStack stackLabel={copy.stackLabel} layers={copy.layers} />

        <div class="explanation">
          <h3>{copy.explanation.heading}</h3>
          <p>{copy.explanation.body}</p>
          <ul class="points">
            {copy.explanation.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .layer-zero {
    --layer-orange: var(--color-accent);
    --layer-orange-soft: var(--color-accent-light);
    --layer-ink: var(--color-ink);
    --layer-muted: var(--color-muted);

    position: relative;
    isolation: isolate;
  }

  .ambient {
    position: absolute;
    z-index: -1;
    inset: -4rem -3rem;
    background: radial-gradient(
      ellipse 32.5rem 22.5rem at 20% 60%,
      rgb(255 158 103 / 8%),
      transparent 65%
    );
    pointer-events: none;
  }

  .intro {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin-block-end: 0.875rem;
    color: var(--color-purple);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    inline-size: 1.25rem;
    block-size: 0.125rem;
    background: var(--layer-orange);
    content: "";
  }

  h2 {
    max-inline-size: 16ch;
    margin-block-end: 0.875rem;
    color: var(--layer-ink);
    font-size: clamp(2.1rem, 3.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .summary {
    max-inline-size: 35rem;
    margin: 0 0 clamp(2.75rem, 6vw, 3.75rem);
    color: var(--layer-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    align-items: start;
  }

  .explanation h3 {
    max-inline-size: 26rem;
    margin-block-end: 1.125rem;
    color: var(--layer-ink);
    font-size: clamp(1.55rem, 3vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .explanation > p {
    max-inline-size: 29rem;
    margin: 0 0 1.375rem;
    color: var(--layer-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .points {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    gap: 0.75rem;
    max-inline-size: 29rem;
    color: var(--layer-ink);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .points li::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-block-start: 0.4rem;
    border-radius: 0.125rem;
    background: var(--layer-orange);
    content: "";
  }

  @media (min-width: 48.75rem) {
    .layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 1fr);
    }
  }

</style>
