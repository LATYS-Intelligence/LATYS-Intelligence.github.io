---
import type { LayerZeroCopy } from "../i18n/pages/home";
import BrandText from "./BrandText.astro";
import Container from "./Container.astro";
import Section from "./Section.astro";

interface Props {
  copy: LayerZeroCopy;
}

const { copy } = Astro.props;
const standardLayers = copy.layers.slice(0, 7);
const foundationLayer = copy.layers[7];
const particles = [
  { position: "12%", delay: "0s" },
  { position: "50%", delay: "1s" },
  { position: "84%", delay: "2s" },
];
---

<Section id="layer-zero" tone="paper">
  <Container>
    <div class="layer-zero">
      <div class="ambient" aria-hidden="true"></div>

      <header class="intro">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2><BrandText text={copy.heading} /></h2>
        <p class="summary">{copy.introduction}</p>
      </header>

      <div class="layout">
        <div class="stack-column">
          <p class="stack-label">{copy.stackLabel}</p>
          <div class="stack">
            <ol class="stack-inner" aria-label={copy.stackLabel}>
              {standardLayers.map((layer) => (
                <li class="layer" data-level={layer.level.slice(1)}>
                  <span class="level">{layer.level}</span>
                  <span class="name">{layer.name}</span>
                  <span class="protocol">{layer.protocol}</span>
                </li>
              ))}
              <li class="layer" data-level="0">
                <span class="level">{foundationLayer.level}</span>
                <span class="name">{foundationLayer.name}</span>
                <span class="protocol">{foundationLayer.protocol}</span>
              </li>
            </ol>

            <div class="rise-wrap" aria-hidden="true">
              {particles.map((particle) => (
                <span
                  class="rise"
                  style={`--particle-position: ${particle.position}; --particle-delay: ${particle.delay};`}
                ></span>
              ))}
            </div>
          </div>
        </div>

        <div class="explanation">
          <h3>{copy.explanation.heading}</h3>
          <p>{copy.explanation.body}</p>
          <ul class="points">
            {copy.explanation.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .layer-zero {
    --layer-orange: var(--color-accent);
    --layer-orange-soft: var(--color-accent-light);
    --layer-ink: var(--color-ink);
    --layer-muted: var(--color-muted);

    position: relative;
    isolation: isolate;
  }

  .ambient {
    position: absolute;
    z-index: -1;
    inset: -4rem -3rem;
    background: radial-gradient(
      ellipse 32.5rem 22.5rem at 20% 60%,
      rgb(255 158 103 / 8%),
      transparent 65%
    );
    pointer-events: none;
  }

  .intro {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin-block-end: 0.875rem;
    color: var(--color-purple);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    inline-size: 1.25rem;
    block-size: 0.125rem;
    background: var(--layer-orange);
    content: "";
  }

  h2 {
    max-inline-size: 16ch;
    margin-block-end: 0.875rem;
    color: var(--layer-ink);
    font-size: clamp(2.1rem, 3.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .summary {
    max-inline-size: 35rem;
    margin: 0 0 clamp(2.75rem, 6vw, 3.75rem);
    color: var(--layer-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    align-items: start;
  }

  .stack-label {
    margin: 0 0 0.875rem;
    color: var(--layer-muted);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack {
    position: relative;
    perspective: 87.5rem;
  }

  .stack-inner {
    display: grid;
    gap: 0.3125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: rotateX(6deg);
    transform-style: preserve-3d;
  }

  .layer {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    min-inline-size: 0;
    padding: 0.8125rem 1.25rem;
    border-radius: 0.375rem;
    box-shadow:
      0 0.1875rem 0 rgb(20 20 25 / 6%),
      0 0.5rem 1rem rgb(20 20 25 / 5%);
  }

  .level {
    color: var(--layer-ink);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .name {
    min-inline-size: 0;
    color: var(--layer-ink);
    font-size: 0.875rem;
    font-weight: 720;
  }

  .protocol {
    min-inline-size: 0;
    color: var(--layer-muted);
    font-family: ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
    text-align: end;
  }

  .layer[data-level="7"] {
    background: linear-gradient(160deg, var(--color-surface), var(--color-accent-light));
  }

  .layer[data-level="6"] {
    background: linear-gradient(160deg, var(--color-surface), var(--color-accent-light));
  }

  .layer[data-level="5"] {
    background: linear-gradient(160deg, var(--color-canvas), var(--color-accent-light));
  }

  .layer[data-level="4"] {
    background: linear-gradient(160deg, var(--color-canvas), var(--color-border));
  }

  .layer[data-level="3"] {
    background: linear-gradient(160deg, var(--color-accent-light), var(--color-border));
  }

  .layer[data-level="2"] {
    background: linear-gradient(160deg, var(--color-accent-light), var(--color-canvas));
  }

  .layer[data-level="1"] {
    background: linear-gradient(160deg, var(--color-accent-light), var(--color-border));
  }

  .layer[data-level="0"] {
    z-index: 3;
    margin-block-start: 0.125rem;
    background: linear-gradient(155deg, var(--color-accent), var(--color-purple));
    box-shadow:
      0 0.625rem 1.625rem rgb(255 158 103 / 40%),
      0 0.1875rem 0 rgb(16 31 90 / 25%);
    animation: lift 3.6s ease-in-out infinite;
  }

  .layer[data-level="0"] .level,
  .layer[data-level="0"] .name {
    color: var(--color-on-dark);
  }

  .layer[data-level="0"] .protocol {
    color: rgb(247 249 255 / 85%);
  }

  .rise-wrap {
    position: absolute;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .rise {
    position: absolute;
    inset-block-end: 2.75rem;
    inset-inline-start: var(--particle-position);
    inline-size: 0.25rem;
    block-size: 0.25rem;
    border-radius: 50%;
    background: var(--layer-orange-soft);
    opacity: 0;
    animation: rise 3s linear infinite;
    animation-delay: var(--particle-delay);
  }

  .explanation h3 {
    max-inline-size: 26rem;
    margin-block-end: 1.125rem;
    color: var(--layer-ink);
    font-size: clamp(1.55rem, 3vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .explanation > p {
    max-inline-size: 29rem;
    margin: 0 0 1.375rem;
    color: var(--layer-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .points {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    gap: 0.75rem;
    max-inline-size: 29rem;
    color: var(--layer-ink);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .points li::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-block-start: 0.4rem;
    border-radius: 0.125rem;
    background: var(--layer-orange);
    content: "";
  }

  @keyframes lift {
    0%,
    100% {
      transform: translateY(0);
      box-shadow:
        0 0.625rem 1.625rem rgb(255 158 103 / 40%),
        0 0.1875rem 0 rgb(16 31 90 / 25%);
    }

    50% {
      transform: translateY(-0.25rem);
      box-shadow:
        0 1.125rem 2.25rem rgb(255 158 103 / 55%),
        0 0.1875rem 0 rgb(16 31 90 / 25%);
    }
  }

  @keyframes rise {
    0% {
      opacity: 0;
      transform: translateY(0);
    }

    10% {
      opacity: 0.9;
    }

    90% {
      opacity: 0.5;
    }

    100% {
      opacity: 0;
      transform: translateY(-20.625rem);
    }
  }

  @media (min-width: 48.75rem) {
    .layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .layer {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.2rem 0.65rem;
      padding: 0.75rem 0.9rem;
    }

    .protocol {
      grid-column: 2;
      text-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer[data-level="0"] {
      animation: none;
    }

    .rise {
      display: none;
    }
  }
</style>
