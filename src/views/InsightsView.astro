---
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import type { Locale } from "../i18n/config";
import { insightsCopy } from "../i18n/pages/insights";
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = insightsCopy[locale];
---

<SiteLayout
  locale={locale}
  route="insights"
  title={copy.meta.title}
  description={copy.meta.description}
>
  <Section id="page-intro" tone="contrast" spacing="compact">
    <Container size="wide">
      <div class="intro">
        <p class="eyebrow">{copy.intro.eyebrow}</p>
        <h1>{copy.intro.heading}</h1>
        <p>{copy.intro.body}</p>
      </div>
    </Container>
  </Section>

  <Section id="page-content" tone="default">
    <Container size="wide">
      <article class="featured">
        <div class="featured-art" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="featured-copy">
          <p class="kicker">{copy.featured.kicker}</p>
          <h2>{copy.featured.title}</h2>
          <p>{copy.featured.body}</p>
        </div>
      </article>

      <div class="insight-grid">
        {copy.items.map((item, index) => (
          <article class="insight-card">
            <div class="card-art" data-index={index} aria-hidden="true"><span></span></div>
            <div class="card-copy">
              <p class="kicker">{item.kicker}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</SiteLayout>

<style>
  .eyebrow,
  .kicker {
    margin-block-end: 1.15rem;
    color: var(--color-accent);
    font-size: 0.73rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .intro {
    max-inline-size: 52rem;
  }

  .intro h1 {
    max-inline-size: 13ch;
    margin-block-end: 1.5rem;
  }

  .intro > p:last-child {
    max-inline-size: 38rem;
    margin: 0;
    color: rgb(247 249 255 / 66%);
    font-size: 1.12rem;
  }

  .featured {
    display: grid;
    overflow: hidden;
    margin-block-end: 1rem;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .featured-art {
    position: relative;
    min-block-size: 19rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 25%, rgb(255 158 103 / 28%), transparent 28%),
      linear-gradient(145deg, var(--color-purple), var(--color-primary));
  }

  .featured-art::before,
  .featured-art::after,
  .featured-art span {
    position: absolute;
    border: 0.0625rem solid rgb(255 158 103 / 45%);
    content: "";
    transform: rotate(-34deg);
  }

  .featured-art::before {
    top: 18%;
    right: 15%;
    inline-size: 16rem;
    block-size: 10rem;
  }

  .featured-art::after {
    top: 32%;
    right: 23%;
    inline-size: 16rem;
    block-size: 10rem;
  }

  .featured-art span:nth-child(1) {
    top: 46%;
    right: 31%;
    inline-size: 16rem;
    block-size: 10rem;
  }

  .featured-art span:nth-child(2) {
    top: 10%;
    left: 10%;
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 2rem var(--color-accent);
  }

  .featured-copy {
    align-self: center;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .featured-copy .kicker,
  .card-copy .kicker {
    color: var(--color-accent-ink);
  }

  .featured-copy h2 {
    max-inline-size: 13ch;
    margin-block-end: 1.25rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .featured-copy > p:last-child,
  .card-copy > p:last-child {
    margin: 0;
    color: var(--color-muted);
  }

  .insight-grid {
    display: grid;
    gap: 1rem;
  }

  .insight-card {
    overflow: hidden;
    border: 0.0625rem solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .card-art {
    position: relative;
    min-block-size: 12rem;
    overflow: hidden;
    background: linear-gradient(150deg, var(--color-purple), var(--color-primary));
  }

  .card-art::before,
  .card-art::after,
  .card-art span {
    position: absolute;
    content: "";
  }

  .card-art::before {
    top: 50%;
    left: 50%;
    inline-size: 13rem;
    block-size: 7rem;
    border: 0.0625rem solid rgb(255 158 103 / 42%);
    transform: translate(-50%, -50%) rotate(calc(-22deg + var(--turn, 0deg)));
  }

  .card-art::after {
    top: 50%;
    left: 50%;
    inline-size: 13rem;
    block-size: 7rem;
    border: 0.0625rem solid rgb(255 158 103 / 24%);
    transform: translate(-42%, -38%) rotate(calc(-22deg + var(--turn, 0deg)));
  }

  .card-art span {
    top: 28%;
    left: 24%;
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 1.5rem var(--color-accent);
  }

  .card-art[data-index="1"],
  .card-art[data-index="4"] {
    --turn: 18deg;
  }

  .card-art[data-index="2"] {
    --turn: -15deg;
  }

  .card-copy {
    padding: 1.75rem;
  }

  .card-copy h3 {
    margin-block-end: 0.85rem;
  }

  @media (min-width: 42rem) {
    .insight-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 56rem) {
    .featured {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    }

    .insight-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
